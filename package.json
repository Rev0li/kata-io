{
  "name": "kata-io",
  "private": true,
  "version": "0.1.0",
  "description": "Kata.io — duel de kung-fu en 1 contre 1 (Phaser, serveur de jeu Node)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "sim": "tsx scripts/simcheck.ts",
    "tour": "tsx scripts/towercheck.ts",
    "serveur": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "pg": "8.23.1",
    "phaser": "4.2.1",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
