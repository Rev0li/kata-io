# Copier en server/.env (jamais dans git) et remplacer la valeur.
POSTGRES_PASSWORD=a-remplacer-par-un-long-mot-de-passe-aleatoire
# Origines autorisées à appeler le serveur directement depuis un navigateur, séparées par des virgules.
# Inutile tant que le jeu passe par le relais de Vercel (même domaine).
KATA_ORIGINES=
